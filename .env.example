# Local Edition environment variables. Names only: copy to .env.local for `next dev`, or set them as
# Cloudflare Worker vars/secrets in production (see docs/SETUP.md). Everything is optional for local dev:
# without keys every provider answers from the synthetic fixtures in fixtures/.

# --- Core providers ---
# Qloo Taste AI key (hackathon host). Required for live Qloo; production is live-only.
QLOO_API_KEY=
# Nebius Token Factory key (Nemotron models and Qwen3 embeddings).
NEBIUS_API_KEY=
# Tavily key (weekly local events, brand-voice crawl).
TAVILY_API_KEY=
# Provider modes outside production: live | replay | fixture (default replay, falling back to fixture).
QLOO_MODE=
TF_MODE=
TAVILY_MODE=

# --- App ---
# memory | file | kv | d1 (default file locally; production must be kv or d1, and uses d1).
STORE_DRIVER=
# Public base URL, used in links and webhook signatures (production: https://localedition.pages.dev).
APP_URL=
# Token Factory spend cap in USD (default 5).
SPEND_CAP_USD=
# workflow | inline: how builds run (production uses Cloudflare Workflows).
BUILD_MODE=
# HMAC key (32+ characters) for the signed job routes (Monday build trigger, NeMo job results).
LE_JOB_SECRET=
# UI only, on typed mock data with no server calls: set to mock.
NEXT_PUBLIC_DATA_MODE=
# Local data and recordings folders (defaults .data and .recordings).
LE_DATA_DIR=
LE_RECORDINGS_DIR=
# debug | info | warn | error
LOG_LEVEL=

# --- Sign-in codes by email (optional) ---
# gmail to send one-time sign-in codes through the Gmail API; unset for password-only sign-in.
CODE_SENDER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Square connector (optional, not connected on the live demo) ---
# live | replay | fixture (default live)
SQUARE_MODE=
SQUARE_ACCESS_TOKEN=
SQUARE_APP_ID=
SQUARE_APP_SECRET=
# sandbox | production (inferred from the app id when unset)
SQUARE_OAUTH_ENV=
# AES-256 key (base64 of 32 bytes) that seals stored Square tokens.
SQUARE_TOKEN_KEY=
SQUARE_WEBHOOK_SIGNATURE_KEY=

# --- Slack connector (optional, not connected on the live demo) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_TEAM_ID=
SLACK_INCOMING_WEBHOOK_URL=
# Channel for the head-office digest (default head-office).
SLACK_HEAD_OFFICE_CHANNEL=

# --- Gmail / Outlook through Composio (optional, not connected on the live demo) ---
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_OUTLOOK=
COMPOSIO_SAMPLE_USER_ID=
COMPOSIO_SAMPLE_GMAIL_ACCOUNT=
COMMS_SAMPLE_MANAGER_EMAIL=
# Encryption key for Slack tokens at rest.
COMMS_ENC_KEY=
